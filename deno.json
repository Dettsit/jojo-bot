{
  "unstable": ["kv", "otel"],
  "tasks": {
    "dev": "deno run --env-file=.env --unstable-cron --unstable-otel --allow-net --allow-env --allow-sys=osRelease --allow-read=/.dockerenv --watch main.ts",
    "seed": "deno run --env-file=.env --allow-net --allow-env seed.ts"
  },
  "imports": {
    "@config/": "./config/",
    "@domain/": "./domain/",
    "@infra/": "./infra/",
    "@messages/": "./messages/",
    "@std/assert": "jsr:@std/assert@1",
    "discord-interactions": "npm:discord-interactions",
    "@aws-sdk/client-dynamodb": "npm:@aws-sdk/client-dynamodb@3",
    "@aws-sdk/lib-dynamodb": "npm:@aws-sdk/lib-dynamodb@3",
    "@opentelemetry/api": "npm:@opentelemetry/api@1"
  }
}
